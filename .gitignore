# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Runtime data
data/*.db
data/*.sqlite3
data/uploads/
data/reports/
# Phase 7 training dataset (rendered crops + manifest; regenerable via documented command)
data/trainset/
# Phase 7 export toolchain for the GPU env (regenerable: uv pip install --target .mltools onnx)
.mltools/
# Model B artifact — 45 MB, regenerate with scripts/train_cnn.py (spec JSON stays committed)
models/cnn.onnx
*.log

# Local screenshots source (kept small, committed deliberately)
# (screenshots/ IS committed — needed for the Round 1 deck)

# Round 1 deck build environment and intermediate renders
deck/.venv/
deck/render/

# LibreOffice lock files — never commit these
.~lock.*
**/.~lock.*

# Browser QA session artifacts (Playwright MCP)
.playwright-mcp/

# Hand-filled copy of the reagent request letter. CHEMICAL_REQUEST.md is the
# tracked, redacted source; the .docx is addressed to a named HOD and carries a
# full name, roll number and institution. Never commit it, never rebuild it
# blindly from the .md — it is hand-edited beyond the source.
CHEMICAL_REQUEST.docx

# Secrets and credentials — never commit
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
id_rsa*
credentials.json
secrets.json
.netrc
# Any file with a credential-looking extension
*.secret
*.token
*.credentials

# Operator test photographs and per-stage diagnostics output (local only;
# regenerated by `python -m saafscan.diagnostics <shot> --out debug/`)
/debug/
Photo*.jpg
Photo*.jpeg
photo*.jpg
photo*.jpeg
